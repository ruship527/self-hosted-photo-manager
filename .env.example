# Copy this file to .env and fill in real values. .env is gitignored.

# Login credentials for the app's single admin account.
ADMIN_USERNAME=admin

# bcrypt hash of the admin password - do NOT put a plaintext password here.
# Generate one with the getpass-based snippet in the README/chat so the
# plaintext password never touches disk or shell history.
ADMIN_PASSWORD_HASH=

# Comma-separated list of origins allowed to make credentialed cross-origin
# requests to the API. Leave empty if the frontend is only ever served from
# this same app (the default docker-compose setup).
ALLOWED_ORIGINS=

# Root folder for uploaded photos/files (photos/ and files/ subfolders are
# created underneath it automatically). Defaults to /DATA/photoapp/uploads,
# matching the volume mount in docker-compose.yml.
# UPLOAD_FOLDER=/DATA/photoapp/uploads

# Set to "true" only once this app is served over https:// (e.g. behind a
# reverse proxy terminating TLS). Leave "false"/unset for plain LAN http://
# access - browsers silently drop Secure cookies over http, which breaks
# login entirely.
COOKIE_SECURE=false

# Folder for the SQLite database file. Defaults to /app/data, matching the
# volume mount in docker-compose.yml.
# DATA_DIR=/app/data

# Maximum size, in megabytes, for a single photo/file upload.
# MAX_UPLOAD_MB=500

# Login lockout: after this many failed attempts from the same client, that
# client is blocked from trying again until the lockout window elapses.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_SECONDS=300
